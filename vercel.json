{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "index.js",
      "functions": {
        "index.js": {
          "maxDuration": 60,
          "includeFiles": [
            "node_modules/pdfkit/js/data/**",
            "node_modules/pdfkit/js/standard-fonts/**"
          ]
        }
      }
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
